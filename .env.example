# Copy to .env and edit. start.sh, stop.sh, status.sh, verify.sh, scripts/download.sh and docker/build.sh read it.
# Run every script on the HEAD node (rank 0). The head reaches the worker (rank 1) with key-based ssh.
# This branch serves the Mia-AiLab EAQ v1 EXL3 checkpoint (39 shards).

# --- The two nodes on the ConnectX-7 link (QSFP cable between the Sparks) ---
HEAD_IP=10.100.80.1            # example head address on the CX7 link (rank 0, rendezvous host); use your own
WORKER_IP=10.100.80.2          # example worker address on the CX7 link (rank 1)
WORKER_SSH=10.100.80.2         # example ssh target for the worker (user@host or an ssh alias)

# --- RoCE and NCCL (see docs/NETWORK.md; `ibdev2netdev` and `ip -br addr` show your names) ---
RDMA_DEVICES=rocep1s0f1,roceP2p1s0f1   # example: TensorFold's own RDMA gathers (both CX7 ports)
NCCL_IB_HCA=rocep1s0f1,roceP2p1s0f1    # example: the two CX7 RoCE devices
NCCL_SOCKET_IFNAME=enp1s0f1np1         # example: the netdev that holds HEAD_IP / WORKER_IP
GID_INDEX=3                            # RoCE v2 IPv4 GID; after a link flap the index can move: set -1 (auto) then

# --- Paths (the same paths on both nodes) ---
MODEL_VIEW=$HOME/models/deepseek-v41-1017-exl3-eaq-2.9bpw   # Mia-AiLab EAQ v1 checkpoint; scripts/download.sh fills model/ and engram/ here
DOWNLOAD_DIR=$MODEL_VIEW.src                           # scripts/download.sh stages files here (same disk as MODEL_VIEW: hard links)
CACHE_DIR=$HOME/tfv41-cache                              # rank caches and compiled kernels (~100 GiB per node)
MIN_SHARDS=39                  # preflight: this checkpoint has 39 weight shards, not 43

# --- Engine image (the unified 1.0 serving recipe; docker/build.sh builds it on the head and copies it to the worker) ---
TF_REPO=https://github.com/Elevatormusic/TensorFold.git
TF_COMMIT=07aa02585f64                 # release dsv41-1.0.0 of the fork; this branch serves 1.0.0
IMAGE=tensorfold-dsv41:07aa02585f64

# --- Serving ---
BIND_HOST=0.0.0.0              # this pair serves the trusted LAN; set API_KEY_FILE when the LAN is not trusted
PORT=8100
SERVED_NAME=DeepSeek-V4.1-Flash-1017
SERVED_ALIAS=deepseek-v41-flash # optional second model id (the id the router already uses)
API_KEY_FILE=                  # optional: a file with one API key per line (mounted read-only); set it for LAN access
CONTEXT=1048576                # 1M tokens: the model's full window
PARALLEL=8                     # concurrent requests on the lane (--parallel)
MTP_DRAFTS=5                   # DSpark draft depth; Mia-AiLab MTP is 4-bit, re-tune after measurement
PREFILL_CHUNK=2048             # positive integer: tokens per prefill chunk on both ranks
SPILL_GIB=32                   # kept prompts also go to CACHE_DIR/tf-ds-spill (max GiB): a prompt survives a restart; 0 = off
MEM_FLOOR_GIB=1.0              # after the warm-up the engine grows only while the node keeps this much memory free (GiB)
CGROUP_PARENT=tensorfold.slice # the no-swap slice from scripts/host_tuning.sh; empty = Docker default (swap allowed)
TEMPERATURE=0.4                # this pair's sampling value for V4.1
TOP_P=1.0
THINKING=1                     # 1: thinking on for requests that do not say (longer replies, more tokens)
REASONING_EFFORT=high          # effort when thinking is on and a request sets none: low, medium, high or xhigh
VISION=1                       # 1: accept image input (--vision)
RESTART_POLICY=unless-stopped  # docker restart policy; see docs/OPERATIONS.md before you change it

# --- Optional experiments (not the serving recipe) ---
#MEM_CAP=0                     # 1: opt in to the memory-topk image's live allocator policy. See docs/MEMORY-TOPK.md
#DROP_UNOFFERED_TOOL_CALLS=1   # 1.1.0 engine only; the 1.0.0 engine ignores it
#PREFLIGHT_NCCL_BOOTSTRAP=1    # 1: preflight also starts a short container on each node and checks the NCCL socket bootstrap (20 s at most); default off

# --- Display-KV launcher only (./start-display-kv.sh, docs/DISPLAY-KV.md). ./start.sh ignores these lines. ---
DISPLAY_KV_BASE=tensorfold-dsv41:07aa02585f64   # 1.0.0 engine base for the display experiment
MEM_ALLOCATOR_CAP=0           # display image: 0: cleanup/telemetry only; 1: hard CUDA allocator cap
TOOL_OUTPUT_STREAMING=1       # display image: 1: prose before the first protocol marker streams; 0 buffers the whole answer
