// compstack.bt: kernel stacks of the engine's direct compaction attempts (order >= 4) and how long each
// sync compaction run takes, keyed by stack. Prints the aggregated maps on exit (Ctrl-C / SIGINT).
tracepoint:compaction:mm_compaction_try_to_compact_pages /comm == "tensorfold" && args->order >= 4/ {
  @attempts[args->order, kstack(perf, 24)] = count();
}
tracepoint:compaction:mm_compaction_try_to_compact_pages /comm == "tensorfold" && args->order >= 7/ { @ustacks[args->order, ustack(perf, 16)] = count(); }
tracepoint:compaction:mm_compaction_begin /comm == "tensorfold"/ { @t[tid] = nsecs; }
tracepoint:compaction:mm_compaction_end /comm == "tensorfold" && @t[tid]/ {
  @ms_by_stack[kstack(perf, 24)] = sum((nsecs - @t[tid]) / 1000000);
  delete(@t[tid]);
}
END { clear(@t); }
